# ── Required ──────────────────────────────────────────────────────────────
# Neon / Vercel Postgres connection string (with the pgvector extension enabled).
# Enable pgvector once:  CREATE EXTENSION IF NOT EXISTS vector;
POSTGRES_URL=

# Vercel AI Gateway key — https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# ── Models (Vercel AI Gateway identifiers) ───────────────────────────────
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Retrieval tuning (optional) ───────────────────────────────────────────
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
RETRIEVAL_LIMIT=6
WORK_SCOPE_LIMIT=4

# ── Ingestion ────────────────────────────────────────────────────────────
# Secret for the protected /api/ingest/reindex endpoint.
# Request with:  Authorization: Bearer <INGEST_SECRET>
INGEST_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://4leibniz.vercel.app
