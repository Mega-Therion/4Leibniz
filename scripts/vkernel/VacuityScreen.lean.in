@IMPORTS@
@TACTIC_IMPORTS@

/-! Vacuity screen (generated by vacuity_screen.py; do not commit the generated file).

For each named theorem: split the conclusion into conjuncts and classify each one by
the failure modes actually seen in chyren-aeon on 2026-10-06 (e8ae1d4, b6ed95b, 2a38838):

* REFLEXIVE      both sides of an `=` are equal up to reducible unfolding (`15/2 = 15/2`)
* HYP-RESTATED   the conclusion is one of the hypotheses (`(h : x = 1) : x = 1 := h`; added
                 2026-10-08 after Res-Nova `physical_frame_tensor_speed_unity` passed without it)
* HYP-PINNED/K   after `subst_vars` on the equality hypotheses, what is left falls in class K
                 (`(hT : c_T = 1) (hγ : c_γ = 1) … : |c_T / c_γ − 1| < ε`; added 2026-10-08 after
                 Res-Nova `gw170817_concordance` passed without it)
* CLOSED-ARITH   no free variables; `norm_num`/`decide`/`simp` closes it (`(-1+2)*(2+2) = 4`)
* RING-ID        holds by `ring` with every hypothesis removed (`x = -(-x)`, `l - l = 0`)
* FIELD-ID       holds by `field_simp`(+`ring`) keeping only `≠`/`<` side conditions
                 (`μ k e / (μ k) = e`)
* PASS           none of the above
A `/unfolded` suffix means the class was reached only after delta-expanding the
project's own definitions. CONTRADICTORY-PREMISES (statement level): `linarith`,
`simp_all` or `norm_num at *` derives `False` from the hypotheses.

A screen is not a proof of non-vacuity: PASS only means none of these patterns fired. -/

open Lean Elab Meta Tactic Command

namespace VacuityScreen

def libRoots : List Name :=
  [`Init, `Std, `Lean, `Mathlib, `Batteries, `Aesop, `Qq, `ProofWidgets, `Plausible,
   `ImportGraph, `LeanSearchClient, `Cli, `Lake]

/-- A definition from the project being screened (not from Lean/Mathlib/deps). -/
def isProjectDef (env : Environment) (n : Name) : Bool :=
  match env.find? n with
  | some (.defnInfo _) =>
    match env.getModuleIdxFor? n with
    | none => true
    | some idx =>
      let m := env.header.moduleNames[idx.toNat]!
      !(libRoots.any fun r => r.isPrefixOf m)
  | _ => false

def tryClose (g : MVarId) (tac : TSyntax `tactic) : TermElabM Bool := do
  let s ← saveState
  try
    let gs ← withCurrHeartbeats <| Tactic.run g (evalTactic tac)
    s.restore
    return gs.isEmpty
  catch _ =>
    s.restore
    return false

def goalWithout (ty : Expr) (drop : Array FVarId) : MetaM MVarId := do
  let mut g := (← mkFreshExprMVar ty).mvarId!
  for f in drop.reverse do
    try g ← g.clear f catch _ => pure ()
  return g

def isSideCond (t : Expr) : Bool :=
  t.isAppOf ``Ne || t.isAppOf ``LT.lt || t.isAppOf ``GT.gt

partial def conjuncts (e : Expr) : List Expr :=
  match e.and? with
  | some (a, b) => conjuncts a ++ conjuncts b
  | none => [e]

def classifyOnce (c : Expr) (propHyps : Array Expr) : TermElabM String := do
  if let some (_, l, r) := c.eq? then
    if ← withReducible (isDefEq l r) then return "REFLEXIVE"
  -- the conclusion is one of the hypotheses (`(h : x = 1) : x = 1 := h`)
  for h in propHyps do
    if ← withReducible (isDefEq (← instantiateMVars (← inferType h)) c) then return "HYP-RESTATED"
  let allProps := propHyps.map (·.fvarId!)
  if !c.hasFVar then
    let g ← goalWithout c allProps
    for tac in [← `(tactic| norm_num), ← `(tactic| decide), ← `(tactic| simp)] do
      if ← tryClose g tac then return "CLOSED-ARITH"
    return "PASS"
  let g ← goalWithout c allProps
  if ← tryClose g (← `(tactic| ring)) then return "RING-ID"
  let mut nonSide := #[]
  for h in propHyps do
    if !isSideCond (← instantiateMVars (← inferType h)) then nonSide := nonSide.push h.fvarId!
  let g2 ← goalWithout c nonSide
  if ← tryClose g2 (← `(tactic| (field_simp; ring))) then return "FIELD-ID"
  if ← tryClose g2 (← `(tactic| field_simp)) then return "FIELD-ID"
  -- a side condition on a product (`μ * k ≠ 0`) cancels as a unit: `simp [*]` uses it directly
  if ← tryClose g2 (← `(tactic| simp [*])) then return "FIELD-ID"
  return "PASS"

/-- Substitute every hypothesis of the form `x = t` / `t = x` (`subst_vars`) and classify what is
left. Catches hypotheses that pin the variables (`(hT : c_T = 1) … : |c_T / c_γ − 1| < ε`). -/
def classifyPinned (c : Expr) : TermElabM String := do
  let g := (← mkFreshExprMVar c).mvarId!
  let s ← saveState
  let res ← try
      let gs ← withCurrHeartbeats <| Tactic.run g (evalTactic (← `(tactic| subst_vars)))
      match gs with
      | [g'] =>
        if (← g'.getType) == c then pure "PASS" else
        g'.withContext do
          let mut ph := #[]
          for d in (← getLCtx) do
            if !d.isImplementationDetail then
              if ← isProp d.type then ph := ph.push (mkFVar d.fvarId)
          let k ← classifyOnce (← instantiateMVars (← g'.getType)) ph
          pure (if k == "PASS" then "PASS" else "HYP-PINNED/" ++ k)
      | _ => pure "PASS"
    catch _ => pure "PASS"
  s.restore
  return res

def classify (c : Expr) (propHyps : Array Expr) : TermElabM String := do
  let k ← classifyOnce c propHyps
  if k != "PASS" then return k
  let env ← getEnv
  let c' ← deltaExpand c (isProjectDef env)
  if c' != c then
    let k' ← classifyOnce c' propHyps
    if k' != "PASS" then return k' ++ "/unfolded"
  classifyPinned c

def screenOne (n : Name) : TermElabM Unit := do
  let ci ← getConstInfo n
  let ty ← zetaReduce ci.type
  forallTelescope ty fun xs body => do
    let body ← zetaReduce (← instantiateMVars body)
    let mut propHyps := #[]
    for x in xs do
      if ← isProp (← inferType x) then propHyps := propHyps.push x
    let mut contra := false
    if !propHyps.isEmpty then
      let gF ← goalWithout (mkConst ``False) #[]
      for tac in [← `(tactic| linarith), ← `(tactic| simp_all), ← `(tactic| norm_num at *)] do
        if !contra then
          if ← tryClose gF tac then contra := true
    let cs := conjuncts body
    let mut ks := #[]
    for c in cs do
      ks := ks.push (← classify c propHyps)
    let stmt :=
      if contra then "CONTRADICTORY-PREMISES"
      else if ks.any (· == "PASS") then "PASS"
      else "+".intercalate (ks.toList.eraseDups)
    logInfo m!"VACUITY|{n}|{stmt}|{",".intercalate ks.toList}"

elab "#vacuity_screen " ids:(ppSpace ident)+ : command => liftTermElabM do
  for id in ids do
    let n := id.getId
    try screenOne n
    catch e => logInfo m!"VACUITY|{n}|ERROR|{← e.toMessageData.toString}"

/-- Screen every theorem whose name starts with `pfx` (declared in imported project modules). -/
elab "#vacuity_screen_prefix " pfx:ident : command => liftTermElabM do
  let env ← getEnv
  let p := pfx.getId
  let names := env.constants.fold (init := #[]) fun acc n ci =>
    match ci with
    | .thmInfo _ => if p.isPrefixOf n && !n.isInternal then acc.push n else acc
    | _ => acc
  for n in names.qsort (·.toString < ·.toString) do
    try screenOne n
    catch e => logInfo m!"VACUITY|{n}|ERROR|{← e.toMessageData.toString}"

end VacuityScreen

set_option maxHeartbeats 200000

@PREAMBLE@

@COMMANDS@
